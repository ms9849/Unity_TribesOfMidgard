    "m_SourceType": 1,
    "m_FunctionName": "GetLightInfo",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#if defined(UNIVERSAL_LIGHTING_INCLUDED)\r\n    Light light = GetMainLight();\r\n    Directional = light.direction;\r\n    Color = light.color;\r\n#else\r\n    Directional = float3(0.5, 0.5, 0); // 에디터 미리보기용 임시 방향\r\n    Color = float3(1, 1, 1);\r\n#endif"
}

